# ============================================================================
# Escalator Starter - Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# For Coolify: Add these in the Environment Variables section
# For local dev: docker compose --env-file .env up
# ============================================================================

# --- Database ---
DB_USER=escalator
DB_PASSWORD=CHANGE_ME_secure_password_here
DB_NAME=escalator

# --- Authentication ---
# Pepper for password hashing (generate with: openssl rand -hex 32)
AUTH_PEPPER=CHANGE_ME_generate_with_openssl_rand_hex_32

# API token for full access (generate with: openssl rand -hex 32)
API_FULL_ACCESS_TOKEN=CHANGE_ME_generate_with_openssl_rand_hex_32

# --- Session Management ---
# Options: memory, database, hybrid
SESSION_CACHE_TYPE=hybrid

# --- Application ---
# External port mapping (default: 30099)
APP_PORT=30099

# --- JVM Options ---
# Adjust based on available memory
JAVA_OPTS=-Xmx512m -Xms256m

# --- Production Only ---
# Uncomment for production deployments
# JAVA_OPTS=-Xmx1g -Xms512m -XX:+UseG1GC
